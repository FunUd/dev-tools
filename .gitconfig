[alias]
    # --- 0. ヘルプ機能 ---
    ha = "!git config --get-regexp '^aliasdoc\\.' | awk '{ \
        split($1, k, \".\"); name = k[2]; \
        val = substr($0, length($1) + 2); \
        split(val, parts, \"|\"); \
        order = parts[1]; \
        group = parts[2]; \
        split(parts[3], desc, \" / 使い方: \"); \
        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", order, group, name, desc[1], desc[2] \
    }' | sort -t $'\\t' -k1,1n | awk -F $'\\t' -v OFS=$'\\t' 'BEGIN { print \"コマンド\\t用途\\t使い方\" } { \
        if ($2 != prev) { \
            if (prev != \"\") print \"\"; \
            print \"【\" $2 \"】\"; \
            prev = $2 \
        } \
        print $3, $4, $5 \
    }' | column -t -s $'\\t'"

    # --- 1. switch/restore 系 ---
    sw = switch
    swc = switch -c
    back = switch -
    rs = restore
    unstage = restore --staged
    restore-to = restore --source

    # fzfでローカルブランチを検索して切り替える
    swf = "!f() { \
        branch=$(git branch --format='%(refname:short)' | \
            fzf --prompt='branch> ' \
                --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$branch\" ] || return 0; \
        git switch -- \"$branch\"; \
    }; f"

    # --- 2. 基本操作・コミット ---
    st = !"_st() { \
        git status -sb; \
        conflicts=$(git diff --name-only --diff-filter=U); \
        if [ -n \"$conflicts\" ]; then \
            echo \"\"; \
            printf \"\\033[31m【⚠️ CONFLICT】衝突しているファイルがあります:\\033[0m\\n\"; \
            echo \"$conflicts\" | sed 's/^/  /'; \
        fi; \
        stashes=$(git stash list 2>/dev/null | wc -l | tr -d ' '); \
        if [ \"$stashes\" -gt 0 ]; then \
            echo \"\"; \
            printf \"\\033[36m【📦 Stash】現在 $stashes 件の作業が退避されています (git sl で確認)\\033[0m\\n\"; \
        fi; \
        if git rev-parse --git-dir >/dev/null 2>&1 && git log -1 >/dev/null 2>&1; then \
            echo \"\"; \
            printf \"\\033[90m【📌 Last Commit】\\033[0m\"; \
            git log -1 --pretty=format:'%C(yellow)%h%Creset - %s %C(green)(%cr)%Creset'; \
            echo \"\"; \
        fi; \
    }; _st"
    sts = !"git status -sb && echo '' && git diff --stat"
    std = !"git status -sb && echo '--- 変更箇所 (単語単位) ---' && git diff --color-words"
    cm = commit -m
    cma = commit --amend
    ca = commit --amend --no-edit
    fixup = commit --fixup
    squash = commit --squash
    aa = add -A

    # fzfで変更ファイルを複数選択してステージングする
    addf = "!f() { \
        files=$({ git diff --name-only; git ls-files --others --exclude-standard; } | \
            sort -u | \
            fzf --multi --prompt='stage files> ' \
                --preview 'git diff --color=always -- {}'); \
        [ -n \"$files\" ] || return 0; \
        printf '%s\\n' \"$files\" | while IFS= read -r file; do \
            git add -- \"$file\"; \
        done; \
    }; f"

    # fzfでステージ済みファイルを複数選択してステージ解除する
    unstagef = "!f() { \
        files=$(git diff --cached --name-only | \
            fzf --multi --prompt='unstage files> ' \
                --preview 'git diff --cached --color=always -- {}'); \
        [ -n \"$files\" ] || return 0; \
        printf '%s\\n' \"$files\" | while IFS= read -r file; do \
            git restore --staged -- \"$file\"; \
        done; \
    }; f"

    # fzfでコミットを選んでrevertする（確認あり）
    revertf = "!f() { \
        entry=$(git log --all --color=never --format='%h %s' | \
            fzf --prompt='revert commit> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        commit=${entry%% *}; \
        printf 'Revert %s? [y/N] ' \"$commit\"; \
        read -r answer < /dev/tty; \
        case \"$answer\" in \
            y|Y) git revert \"$commit\" ;; \
            *) echo 'Cancelled.' ;; \
        esac; \
    }; f"

    # --- 3. ログ表示 ---
    lg = log --graph --oneline --decorate
    lga = log --graph --all --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    lgn = !"git lga -n 10"
    last = log -1 --stat --decorate --oneline
    lgs = log --graph --stat --name-status --pretty=format:'%C(yellow)commit %h%Creset%C(auto)%d%Creset%nAuthor: %an <%ae>%nDate:   %cd%n%n    %s%n'
    lgf = !sh -c 'git log --follow --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -p -- \"$1\"' -
    lgh = !sh -c 'git log --graph --pretty=format:\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset\" -G\"$1\"' -

    # fzfでコミットを検索して詳細表示する
    showf = "!f() { \
        entry=$(git log --all --color=never --format='%h %s (%cr) <%an>' | \
            fzf --no-sort --prompt='commit> ' \
                --preview 'git show --stat --oneline --decorate --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        commit=${entry%% *}; \
        git show --color=always \"$commit\"; \
    }; f"

    # fzfでコミットメッセージをキーワード検索する
    findc = "!f() { \
        printf 'Keyword: '; \
        read -r keyword < /dev/tty; \
        [ -n \"$keyword\" ] || return 0; \
        entry=$(git log --all --regexp-ignore-case --grep=\"$keyword\" \
            --color=never --format='%h %s (%cr)' | \
            fzf --prompt='matching commits> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        commit=${entry%% *}; \
        git show --color=always \"$commit\"; \
    }; f"

    # fzfでreflogを検索して選択地点を表示する
    reflogf = "!f() { \
        entry=$(git reflog --date=relative --format='%gd %h %gs (%cr)' | \
            fzf --prompt='reflog> ' \
                --preview 'git show --stat --oneline --color=always {2}'); \
        [ -n \"$entry\" ] || return 0; \
        ref=${entry%% *}; \
        git show --color=always \"$ref\"; \
    }; f"

    # fzfでファイルを選択して履歴を表示する
    filelogf = "!f() { \
        file=$(git ls-files | \
            fzf --prompt='file history> ' \
                --preview 'git log --follow --oneline --decorate -- {}'); \
        [ -n \"$file\" ] || return 0; \
        git log --follow --oneline --decorate -- \"$file\"; \
    }; f"

    # --- 4. クリーンアップ・ブランチ管理 ---
    br = branch -vv --sort=committerdate
    brs = branch -vv
    brm = branch -m
    bclean = !"_bclean() { \
        default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo 'main'); \
        echo 'Fetching remote status and pruning...'; \
        git fetch -p; \
        branches=$(git branch --merged | grep -Ev \"^(\\*|[[:space:]]*($default_branch|master|develop)$)\" | sed 's/^[[:space:]]*//'); \
        if [ -z \"$branches\" ]; then \
            echo '削除対象のマージ済みローカルブランチはありません。'; \
            return 0; \
        fi; \
        echo '--- 以下のマージ済みローカルブランチを削除します ---'; \
        echo \"$branches\" | sed 's/^/  /'; \
        printf '本当に削除しますか？ [y/N]: '; \
        read -r answer < /dev/tty; \
        if [ \"$answer\" = 'y' ] || [ \"$answer\" = 'Y' ]; then \
            echo \"$branches\" | xargs git branch -d; \
        else \
            echo 'キャンセルのため、ブランチ削除を中止しました。'; \
        fi; \
    }; _bclean"
    fa = !"git fetch --prune --all && echo 'All remotes pruned and synced.'"

    # fzfでブランチを2つ選んで比較する
    bdiff = "!f() { \
        base=$(git branch --format='%(refname:short)' | \
            fzf --prompt='base branch> ' \
                --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$base\" ] || return 0; \
        target=$(git branch --format='%(refname:short)' | \
            fzf --prompt='compare branch> ' \
                --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$target\" ] || return 0; \
        git diff --stat \"$base...$target\"; \
        git diff \"$base...$target\"; \
    }; f"

    # fzfでリモートブランチを選んで追跡ブランチを作成・切り替え
    rbf = "!f() { \
        remote=$(git for-each-ref --format='%(refname:short)' refs/remotes | \
            grep -v '/HEAD$' | \
            fzf --prompt='remote branch> ' \
                --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$remote\" ] || return 0; \
        local_branch=${remote#*/}; \
        if git show-ref --verify --quiet \"refs/heads/$local_branch\"; then \
            git switch -- \"$local_branch\"; \
        else \
            git switch --track -c \"$local_branch\" \"$remote\"; \
        fi; \
    }; f"

    # fzfでマージ済みブランチを選択して削除する（確認あり）
    bcleanf = "!f() { \
        current=$(git branch --show-current); \
        branches=$(git branch --merged --format='%(refname:short)' | \
            grep -Fxv \"$current\" | \
            grep -vE '^(main|master|develop)$' | \
            fzf --multi --prompt='merged branches> ' \
                --preview 'git log -3 --oneline --decorate --color=always {}'); \
        [ -n \"$branches\" ] || return 0; \
        printf '%s\\n' \"$branches\"; \
        printf 'Delete selected merged branches? [y/N] '; \
        read -r answer < /dev/tty; \
        case \"$answer\" in \
            y|Y) printf '%s\\n' \"$branches\" | while IFS= read -r branch; do \
                git branch -d -- \"$branch\"; \
            done ;; \
            *) echo 'Cancelled.' ;; \
        esac; \
    }; f"

    # --- 5. Worktree 操作 ---
    wt = worktree
    wtl = worktree list
    wtr = worktree remove
    wta = !"sh -c ' \
        if [ -z \"$1\" ]; then \
            echo \"Error: ブランチ名が指定されていません。\"; \
            echo \"使い方: git wta <branch> [<path>]\"; \
            exit 1; \
        fi; \
        branch=$1; \
        custom_path=$2; \
        if ! git rev-parse --verify --quiet \"$branch\" >/dev/null 2>&1; then \
            echo \"Error: 既存のブランチ [$branch] が見つかりません。新規作成する場合は git wtn を使用してください。\"; \
            exit 1; \
        fi; \
        if [ -n \"$custom_path\" ]; then \
            path=\"$custom_path\"; \
        else \
            repo_root=$(git rev-parse --show-toplevel); \
            repo_name=$(basename \"$repo_root\"); \
            safe_name=$(printf \"%s-%s\" \"$repo_name\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"$repo_root/../$safe_name\"; \
        fi; \
        echo \"既存ブランチ [$branch] を [$path] に展開します...\"; \
        git worktree add \"$path\" \"$branch\"' -"
    wtn = !"sh -c ' \
        if [ -z \"$1\" ]; then \
            echo \"Error: 新規ブランチ名が指定されていません。\"; \
            echo \"使い方: git wtn <new-branch> [<start-point>] [<path>]\"; \
            exit 1; \
        fi; \
        branch=$1; \
        start=$2; \
        custom_path=$3; \
        if [ -z \"$start\" ] || [ -d \"$start\" ]; then \
            custom_path=$start; \
            start=\"\"; \
        fi; \
        if [ -n \"$custom_path\" ]; then \
            path=\"$custom_path\"; \
        else \
            repo_root=$(git rev-parse --show-toplevel); \
            repo_name=$(basename \"$repo_root\"); \
            safe_name=$(printf \"%s-%s\" \"$repo_name\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"$repo_root/../$safe_name\"; \
        fi; \
        if [ -n \"$start\" ]; then \
            echo \"[$start] から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\" \"$start\"; \
        else \
            echo \"現在の HEAD から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\"; \
        fi' -"
    wtp = "!git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | fzf --prompt='worktree> ' | clip.exe"

    # --- 6. add -p 補助 ---
    ap = add -p
    ad = !git diff && git add -p
    aps = !git add -p && git status --short
    apc = !git add -p && git commit
    apcm = !git add -p && git commit -m

    # --- 7. Stash・退避操作 ---
    sl = stash list
    sa = stash apply
    sp = stash push -m
    stash-wip = stash push --include-untracked -m "wip"
    unsh = stash pop --index

    # fzfでstashを検索して適用する（stashは削除しない）
    stashf = "!f() { \
        entry=$(git stash list --format='%gd %gs' | \
            fzf --prompt='stash> ' \
                --preview 'git stash show --stat --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        stash=${entry%% *}; \
        git stash apply \"$stash\"; \
    }; f"

    # fzfでstashを選んで削除する（確認あり）
    stashdropf = "!f() { \
        entry=$(git stash list --format='%gd %gs' | \
            fzf --prompt='drop stash> ' \
                --preview 'git stash show --stat --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        stash=${entry%% *}; \
        printf 'Drop %s? [y/N] ' \"$stash\"; \
        read -r answer < /dev/tty; \
        case \"$answer\" in \
            y|Y) git stash drop \"$stash\" ;; \
            *) echo 'Cancelled.' ;; \
        esac; \
    }; f"

    # --- 8. 差分・履歴操作 ---
    d = diff
    dc = diff --cached
    uncommit = reset --soft HEAD^
    dw = diff -w --ignore-all-space
    dwo = diff --word-diff
    reword-at = !sh -c 'git commit --allow-empty --fixup=reword:\"$1\" && GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash \"$1\"~1' -

    # fzfで未ステージ差分のファイルを選んで表示する
    dfu = "!f() { \
        file=$(git diff --name-only | \
            fzf --prompt='unstaged diff> ' \
                --preview 'git diff --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; \
        git diff -- \"$file\"; \
    }; f"

    # fzfでステージ済み差分のファイルを選んで表示する
    dfs = "!f() { \
        file=$(git diff --cached --name-only | \
            fzf --prompt='staged diff> ' \
                --preview 'git diff --cached --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; \
        git diff --cached -- \"$file\"; \
    }; f"

    # fzfで2コミット間の変更ファイルを選んで差分表示する
    rangef = "!f() { \
        base_entry=$(git log --all --color=never --format='%h %s' | \
            fzf --prompt='base commit> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$base_entry\" ] || return 0; \
        base=${base_entry%% *}; \
        target_entry=$(git log --all --color=never --format='%h %s' | \
            fzf --prompt='target commit> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$target_entry\" ] || return 0; \
        target=${target_entry%% *}; \
        file=$(git diff --name-only \"$base\" \"$target\" | \
            fzf --prompt='changed files> ' \
                --preview \"git diff --color=always $base $target -- {}\"); \
        [ -n \"$file\" ] || return 0; \
        git diff \"$base\" \"$target\" -- \"$file\"; \
    }; f"

    # fzfでコンフリクトファイルを選択してマージツールを起動する
    conff = "!f() { \
        file=$(git diff --name-only --diff-filter=U | \
            fzf --prompt='conflict> ' \
                --preview 'git diff --cc --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; \
        git mergetool -- \"$file\"; \
    }; f"

    # --- 9. 特殊分析・調査 ---
    today = !"git log --author=\"$(git config user.name)\" --since=\"midnight\" --no-merges --pretty=format:'%C(yellow)%h%Creset %s (%cr)'"
    hh = !"_hh() { \
            count=${1:-1}; \
            git log -n \"$count\" --format='%H' | { \
                if command -v clip >/dev/null 2>&1; then clip; \
                elif command -v pbcopy >/dev/null 2>&1; then pbcopy; \
                elif command -v xclip >/dev/null 2>&1; then xclip -sel clip; \
                else echo 'Error: No clipboard command found.' >&2; exit 1; \
                fi; \
            } && echo \"Copied recent $count HEAD hash(es) to clipboard.\"; \
        }; _hh"
    lf = !"git ls-files -z | xargs -0 wc -l | sort -rn | head -n 20"
    cf = diff --name-only --diff-filter=U
    cfe = !"files=$(git cf); if [ -n \"$files\" ]; then echo \"$files\" | xargs ${VISUAL:-${EDITOR:-code --wait}}; fi"
    hotfiles = !"git log --name-only --since='1 month ago' --pretty=format: | grep -v '^$' | sort | uniq -c | sort -nr | head -n 20"
    changelog = !"git log $(git describe --tags --abbrev=0)..HEAD --oneline"
    ref = reflog --date=relative

    # --- 10. その他ショートカット ---
    db = !"git switch $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
    up = pull --rebase --autostash
    pub = !"git push -u origin HEAD"
    rdb = !"git fetch origin && git rebase origin/$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') --autostash"


[aliasdoc]
    ha = 00|ヘルプ|alias の一覧と用途を使用タイミングごとに表示 / 使い方: git ha

    # --- 切り替え・復元 ---
    sw = 10|切り替え・復元|ブランチを切り替える / 使い方: git sw <ブランチ名>
    swc = 11|切り替え・復元|新規ブランチを作成して即切り替える / 使い方: git swc <新ブランチ名>
    back = 12|切り替え・復元|直前にいたブランチへ戻る / 使い方: git back
    rs = 13|切り替え・復元|ワークツリーの変更を破棄してファイルをもとに戻す / 使い方: git rs <ファイル名>
    unstage = 14|切り替え・復元|ステージングを取り消す / 使い方: git unstage <ファイル名>
    restore-to = 15|切り替え・復元|指定したコミットの内容でファイルを作業ツリーに戻す / 使い方: git restore-to <commit> <ファイル名>
    swf = 16|切り替え・復元|fzfでブランチを検索して切り替える / 使い方: git swf

    # --- コミット・変更 ---
    st = 20|コミット・変更|ブランチ名とステータス要約を表示 / 使い方: git st
    aa = 21|コミット・変更|全変更をステージングする / 使い方: git aa
    cm = 22|コミット・変更|メッセージ付きでコミットする / 使い方: git cm "<メッセージ>"
    cma = 23|コミット・変更|直前のコミットメッセージを修正する / 使い方: git cma
    ca = 24|コミット・変更|直前のコミットに変更を統合する / 使い方: git ca
    fixup = 25|コミット・変更|指定コミットへの fixup を作成する / 使い方: git fixup <commit>
    squash = 26|コミット・変更|指定コミットへの squash を作成する / 使い方: git squash <commit>
    ap = 27|コミット・変更|差分を選んでインタラクティブにステージングする / 使い方: git ap
    ad = 28|コミット・変更|差分確認のあとに add -p を開始する / 使い方: git ad
    aps = 29|コミット・変更|add -p のあとにステータスを表示する / 使い方: git aps
    apc = 30|コミット・変更|add -p のあとに commit を開始する / 使い方: git apc
    apcm = 31|コミット・変更|add -p のあとにメッセージ付きでコミットする / 使い方: git apcm "<メッセージ>"
    sts = 32|コミット・変更|ステータス要約と未ステージ差分の統計を表示する / 使い方: git sts
    std = 33|コミット・変更|ステータスと単語単位のコンパクトな差分を表示する / 使い方: git std
    addf = 34|コミット・変更|fzfで変更ファイルを複数選択してステージングする / 使い方: git addf
    unstagef = 35|コミット・変更|fzfでステージ済みファイルを複数選択してステージ解除する / 使い方: git unstagef
    revertf = 36|コミット・変更|fzfでコミットを選んでrevertする（確認あり） / 使い方: git revertf

    # --- 差分・修正 ---
    d = 40|差分・修正|差分を確認する / 使い方: git d
    dc = 41|差分・修正|ステージング済みの差分を確認する / 使い方: git dc
    dw = 42|差分・修正|空白差分を無視して比較する / 使い方: git dw
    dwo = 43|差分・修正|単語単位で詳細比較する / 使い方: git dwo
    uncommit = 44|差分・修正|直前のコミットを取り消して変更を保持する / 使い方: git uncommit
    reword-at = 45|差分・修正|過去のコミットをfixup経由で修正する / 使い方: git reword-at <hash>
    dfu = 46|差分・修正|fzfで未ステージ差分のファイルを選んで表示する / 使い方: git dfu
    dfs = 47|差分・修正|fzfでステージ済み差分のファイルを選んで表示する / 使い方: git dfs
    rangef = 48|差分・修正|2コミット間の変更ファイルを選んで差分表示する / 使い方: git rangef
    conff = 49|差分・修正|fzfでコンフリクトファイルを選んでマージツールを起動する / 使い方: git conff

    # --- ログ・履歴 ---
    lg = 50|ログ・履歴|履歴を簡易グラフ表示する / 使い方: git lg
    lga = 51|ログ・履歴|全履歴を1行でグラフ表示する / 使い方: git lga
    lgn = 52|ログ・履歴|直近10件のみ表示する / 使い方: git lgn
    last = 53|ログ・履歴|直近コミットの要約と変更統計を表示する / 使い方: git last
    lgs = 54|ログ・履歴|ファイル変更統計付きでログを表示する / 使い方: git lgs
    lgf = 55|ログ・履歴|指定ファイルの変更内容を徹底追跡する / 使い方: git lgf <ファイル名>
    lgh = 56|ログ・履歴|コミットの差分内容から指定キーワードを検索する / 使い方: git lgh <検索語>
    showf = 57|ログ・履歴|fzfでコミットを検索して詳細表示する / 使い方: git showf
    findc = 58|ログ・履歴|コミットメッセージをキーワード検索する / 使い方: git findc
    reflogf = 59|ログ・履歴|fzfでreflogを検索して選択地点を表示する / 使い方: git reflogf
    filelogf = 60|ログ・履歴|fzfでファイルを選択して履歴を表示する / 使い方: git filelogf

    # --- ブランチ整理 ---
    br = 60|ブランチ整理|更新順にブランチ詳細一覧を表示する / 使い方: git br
    brs = 61|ブランチ整理|ブランチ詳細一覧を表示する / 使い方: git brs
    brm = 62|ブランチ整理|現在のブランチ名を変更する / 使い方: git brm <新しいブランチ名>
    bdiff = 63|ブランチ整理|fzfで2つのブランチを選んで比較する / 使い方: git bdiff
    bclean = 64|ブランチ整理|マージ済みローカルブランチを確認後に一括削除する / 使い方: git bclean
    bcleanf = 65|ブランチ整理|fzfでマージ済みブランチを選択して削除する / 使い方: git bcleanf
    rbf = 66|ブランチ整理|fzfでリモートブランチを選んで追跡ブランチを作成・切り替える / 使い方: git rbf
    fa = 67|ブランチ整理|全リモートの最新状態を反映し、削除済みブランチを掃除する / 使い方: git fa

    # --- worktree ---
    wt = 70|worktree|worktreeサブコマンドの入り口 / 使い方: git wt
    wtl = 71|worktree|worktreeの一覧を表示する / 使い方: git wtl
    wta = 72|worktree|既存ブランチをworktreeとして展開する / 使い方: git wta <branch> [<path>]
    wtn = 73|worktree|新規ブランチをworktreeとして展開する / 使い方: git wtn <new-branch> [<start-point>] [<path>]
    wtr = 74|worktree|worktreeを削除する / 使い方: git wtr <path>
    wtp = 75|ブランチ整理|worktree のパスを fzf で選択してクリップボードにコピー|wtp

    # --- 退避・stash ---
    sl = 80|退避・stash|退避履歴を表示する / 使い方: git sl
    sa = 81|退避・stash|退避した作業を適用する / 使い方: git sa
    sp = 82|退避・stash|メッセージを指定して一時退避する / 使い方: git sp "<メッセージ>"
    stash-wip = 83|退避・stash|未追跡を含めて作業を一時退避する / 使い方: git stash-wip
    unsh = 84|退避・stash|ステージング状態を維持して復元する / 使い方: git unsh
    stashf = 85|退避・stash|fzfでstashを検索して適用する / 使い方: git stashf
    stashdropf = 86|退避・stash|fzfでstashを選択して削除する（確認あり） / 使い方: git stashdropf

    # --- 調査・診断 ---
    today = 90|調査・診断|今日の作業を作者名ベースで表示する / 使い方: git today
    hh = 91|調査・診断|HEADのハッシュをクリップボードへコピーする / 使い方: git hh [<個数>]
    lf = 92|調査・診断|巨大ファイルを調べる / 使い方: git lf
    cf = 93|調査・診断|コンフリクト中のファイル一覧を表示する / 使い方: git cf
    cfe = 94|調査・診断|コンフリクトファイルをエディタで開く / 使い方: git cfe
    hotfiles = 95|調査・診断|よく触るファイルを集計する / 使い方: git hotfiles
    changelog = 96|調査・診断|リリース間の更新一覧を表示する / 使い方: git changelog
    ref = 97|調査・診断|reflogを相対時刻付きで表示する / 使い方: git ref

    # --- 定番操作 ---
    db = 100|定番操作|originの既定ブランチへ切り替える / 使い方: git db
    up = 101|定番操作|rebase付きでpullする / 使い方: git up
    pub = 102|定番操作|現在のブランチをoriginに公開する / 使い方: git pub
    rdb = 103|定番操作|originの既定ブランチへ追従してrebaseする / 使い方: git rdb