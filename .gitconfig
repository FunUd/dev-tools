[alias]
    # --- 0. ヘルプ機能 ---
    ha = "!git config --get-regexp '^aliasdoc\\.' | awk '{ \
        split($1, k, \".\"); name = substr($1, 10); \
        val = substr($0, length($1) + 2); \
        split(val, parts, \"|\"); \
        order = parts[1]; group = parts[2]; \
        split(parts[3], desc, \" / 使い方: \"); \
        printf \"%s\\t%s\\t%s\\t%s\\t%s\\n\", order, group, name, desc[1], desc[2] \
    }' | sort -t $'\\t' -k1,1n -k3,3 | awk -F $'\\t' -v OFS=$'\\t' 'BEGIN { print \"コマンド\\t用途\\t使い方\" } { \
        if ($2 != prev) { if (prev != \"\") print \"\"; print \"【\" $2 \"】\"; prev = $2 } \
        print $3, $4, $5 \
    }' | column -t -s $'\\t'"

    # --- 1. switch / restore ---
    sw = switch
    swc = switch -c
    back = switch -
    rs = restore
    unstage = restore --staged
    restore-to = restore --source

    # fzfでローカルブランチを検索して切り替える
    swf = "!f() { \
        branch=$(git branch --format='%(refname:short)' | \
            fzf --prompt='branch> ' \
                --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$branch\" ] || return 0; \
        git switch -- \"$branch\"; \
    }; f"

    # --- 2. 基本操作・コミット ---
    st = !"_st() { \
        git status -sb; \
        conflicts=$(git diff --name-only --diff-filter=U); \
        if [ -n \"$conflicts\" ]; then \
            echo; printf \"\\033[31m【CONFLICT】衝突しているファイルがあります:\\033[0m\\n\"; \
            printf '%s\\n' \"$conflicts\" | sed 's/^/  /'; \
        fi; \
        stashes=$(git stash list 2>/dev/null | wc -l | tr -d ' '); \
        if [ \"$stashes\" -gt 0 ]; then \
            echo; printf \"\\033[36m【Stash】退避中: %s 件 (git sl で確認)\\033[0m\\n\" \"$stashes\"; \
        fi; \
        if git log -1 >/dev/null 2>&1; then \
            echo; printf \"\\033[90m【Last Commit】\\033[0m\"; \
            git log -1 --pretty=format:'%C(yellow)%h%Creset - %s %C(green)(%cr)%Creset'; echo; \
        fi; \
    }; _st"
    sts = !"git status -sb && echo '' && git diff --stat"
    std = !"git status -sb && echo '--- 変更箇所 (単語単位) ---' && git diff --color-words"
    cm = commit -m
    cma = commit --amend
    ca = commit --amend --no-edit
    fixup = commit --fixup
    squash = commit --squash
    aa = add -A

    # fzfで変更ファイルを複数選択してステージング
    addf = "!f() { \
        files=$({ git diff --name-only; git ls-files --others --exclude-standard; } | sort -u | \
            fzf --multi --prompt='stage files> ' \
                --preview 'git diff --color=always -- {}'); \
        [ -n \"$files\" ] || return 0; \
        printf '%s\\n' \"$files\" | while IFS= read -r file; do git add -- \"$file\" || exit 1; done; \
    }; f"

    # fzfでステージ済みファイルを複数選択してステージ解除
    unstagef = "!f() { \
        files=$(git diff --cached --name-only | \
            fzf --multi --prompt='unstage files> ' \
                --preview 'git diff --cached --color=always -- {}'); \
        [ -n \"$files\" ] || return 0; \
        printf '%s\\n' \"$files\" | while IFS= read -r file; do git restore --staged -- \"$file\" || exit 1; done; \
    }; f"

    # fzfでコミットを選んでrevert（確認あり）
    revertf = "!f() { \
        entry=$(git log --all --no-merges --color=never --format='%h %s' | \
            fzf --prompt='revert commit> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        commit=${entry%% *}; \
        printf 'Revert %s? [y/N] ' \"$commit\"; \
        read -r answer < /dev/tty; \
        case \"$answer\" in y|Y) git revert \"$commit\" ;; *) echo 'Cancelled.' ;; esac; \
    }; f"

    # --- 3. ログ表示 ---
    lg = log --graph --oneline --decorate
    lga = log --graph --all --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    lgn = !"git lga -n 10"
    last = log -1 --stat --decorate --oneline
    lgs = log --graph --stat --name-status --pretty=format:'%C(yellow)commit %h%Creset%C(auto)%d%Creset%nAuthor: %an <%ae>%nDate:   %cd%n%n    %s%n'
    lgf = !sh -c 'git log --follow --graph --pretty=format:"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset" -p -- "$1"' -
    lgh = !sh -c 'git log --graph --pretty=format:"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset" -G"$1"' -

    # fzfでコミットを検索して詳細表示
    showf = "!f() { \
        entry=$(git log --all --color=never --format='%h %s (%cr) <%an>' | \
            fzf --no-sort --prompt='commit> ' \
                --preview 'git show --stat --oneline --decorate --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        git show --color=always \"${entry%% *}\"; \
    }; f"

    # コミットメッセージを文字列検索
    findc = "!f() { \
        printf 'Keyword: '; read -r keyword < /dev/tty; \
        [ -n \"$keyword\" ] || return 0; \
        entry=$(git log --all --fixed-strings --regexp-ignore-case --grep=\"$keyword\" \
            --color=never --format='%h %s (%cr)' | \
            fzf --prompt='matching commits> ' \
                --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        git show --color=always \"${entry%% *}\"; \
    }; f"

    # fzfでreflogを検索
    reflogf = "!f() { \
        entry=$(git reflog --date=relative --format='%gd %h %gs (%cr)' | \
            fzf --prompt='reflog> ' \
                --preview 'git show --stat --oneline --color=always {2}'); \
        [ -n \"$entry\" ] || return 0; \
        ref=${entry%% *}; git show --color=always \"$ref\"; \
    }; f"

    # fzfでファイルを選択して履歴を表示
    filelogf = "!f() { \
        file=$(git ls-files | \
            fzf --prompt='file history> ' \
                --preview 'git log --follow --oneline --decorate -- {}'); \
        [ -n \"$file\" ] || return 0; \
        git log --follow --oneline --decorate -- \"$file\"; \
    }; f"

    # --- 4. ブランチ管理 ---
    br = branch -vv --sort=-committerdate
    brs = branch -vv
    brm = branch -m

    # デフォルトブランチへのマージ済みブランチを確認して削除
    bclean = !"_bclean() { \
        if ! git rev-parse --verify origin/HEAD >/dev/null 2>&1; then \
            echo 'Error: origin/HEAD が未設定です。git remote set-head origin --auto を実行してください。' >&2; \
            return 1; \
        fi; \
        default_ref=$(git symbolic-ref refs/remotes/origin/HEAD) || return 1; \
        default_branch=${default_ref#refs/remotes/origin/}; \
        echo 'Fetching remote status and pruning...'; \
        git fetch -p || return 1; \
        git show-ref --verify --quiet \"refs/remotes/origin/$default_branch\" || { echo 'Error: デフォルトブランチが見つかりません。' >&2; return 1; }; \
        current=$(git branch --show-current); \
        branches=$(git branch --merged \"origin/$default_branch\" --format='%(refname:short)' | \
            grep -Fxv \"$default_branch\" | grep -Fxv \"$current\"); \
        if [ -z \"$branches\" ]; then echo '削除対象のマージ済みローカルブランチはありません。'; return 0; fi; \
        echo \"--- origin/$default_branch にマージ済みのブランチ ---\"; \
        printf '%s\\n' \"$branches\"; \
        printf '本当に削除しますか？ [y/N]: '; read -r answer < /dev/tty; \
        case \"$answer\" in \
            y|Y) printf '%s\\n' \"$branches\" | while IFS= read -r branch; do git branch -d -- \"$branch\" || exit 1; done ;; \
            *) echo 'キャンセルしました。' ;; \
        esac; \
    }; _bclean"

    fa = !"git fetch --prune --all && echo 'All remotes fetched and pruned.'"

    # fzfでブランチを2つ選んで比較
    bdiff = "!f() { \
        base=$(git branch --format='%(refname:short)' | \
            fzf --prompt='base branch> ' --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$base\" ] || return 0; \
        target=$(git branch --format='%(refname:short)' | \
            fzf --prompt='compare branch> ' --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$target\" ] || return 0; \
        git diff --stat \"$base...$target\" && git diff \"$base...$target\"; \
    }; f"

    # fzfでリモートブランチを選択して追跡ブランチを作成・切り替え
    rbf = "!f() { \
        remote=$(git for-each-ref --format='%(refname:short)' refs/remotes | \
            grep -v '/HEAD$' | \
            fzf --prompt='remote branch> ' --preview 'git log -5 --oneline --decorate --color=always {}'); \
        [ -n \"$remote\" ] || return 0; \
        local_branch=${remote#*/}; \
        if git show-ref --verify --quiet \"refs/heads/$local_branch\"; then \
            git switch -- \"$local_branch\"; \
        else \
            git switch --track -c \"$local_branch\" \"$remote\"; \
        fi; \
    }; f"

    # fzfでデフォルトブランチにマージ済みのブランチを選んで削除
    bcleanf = "!f() { \
        if ! git rev-parse --verify origin/HEAD >/dev/null 2>&1; then \
            echo 'Error: origin/HEAD が未設定です。' >&2; return 1; \
        fi; \
        default_ref=$(git symbolic-ref refs/remotes/origin/HEAD) || return 1; \
        default_branch=${default_ref#refs/remotes/origin/}; \
        current=$(git branch --show-current); \
        branches=$(git branch --merged \"origin/$default_branch\" --format='%(refname:short)' | \
            grep -Fxv \"$default_branch\" | grep -Fxv \"$current\" | \
            fzf --multi --prompt='merged branches> ' \
                --preview 'git log -3 --oneline --decorate --color=always {}'); \
        [ -n \"$branches\" ] || return 0; \
        printf '%s\\n' \"$branches\"; \
        printf 'Delete selected merged branches? [y/N] '; read -r answer < /dev/tty; \
        case \"$answer\" in \
            y|Y) printf '%s\\n' \"$branches\" | while IFS= read -r branch; do git branch -d -- \"$branch\" || exit 1; done ;; \
            *) echo 'Cancelled.' ;; \
        esac; \
    }; f"

    # --- 5. Worktree ---
    wt = worktree
    wtl = worktree list
    wtr = worktree remove

    # 既存ブランチをworktreeに展開
    wta = !"sh -c ' \
        if [ -z \"$1\" ]; then echo \"使い方: git wta <branch> [<path>]\" >&2; exit 2; fi; \
        branch=$1; custom_path=$2; \
        if ! git show-ref --verify --quiet \"refs/heads/$branch\"; then \
            echo \"Error: ローカルブランチ [$branch] が見つかりません。\" >&2; exit 1; \
        fi; \
        if [ -n \"$custom_path\" ]; then path=$custom_path; \
        else \
            repo_root=$(git rev-parse --show-toplevel) || exit 1; \
            repo_name=$(basename \"$repo_root\"); \
            safe_name=$(printf \"%s-%s\" \"$repo_name\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"$repo_root/../$safe_name\"; \
        fi; \
        echo \"既存ブランチ [$branch] を [$path] に展開します...\"; \
        git worktree add \"$path\" \"$branch\"' -"

    # 新規ブランチをworktreeに展開
    # 形式: git wtn <branch> [<start-point>] [<path>]
    # 新形式: git wtn <branch> [--start-point <ref>] [--path <path>]
    wtn = !"sh -c ' \
        if [ -z \"$1\" ]; then \
            echo \"使い方: git wtn <branch> [--start-point <ref>] [--path <path>]\" >&2; \
            echo \"旧形式: git wtn <branch> [<start-point>] [<path>]\" >&2; exit 2; \
        fi; \
        branch=$1; shift; start=; custom_path=; \
        while [ $# -gt 0 ]; do \
            case \"$1\" in \
                --start-point) [ $# -ge 2 ] || { echo \"--start-point に値が必要です。\" >&2; exit 2; }; start=$2; shift 2 ;; \
                --path) [ $# -ge 2 ] || { echo \"--path に値が必要です。\" >&2; exit 2; }; custom_path=$2; shift 2 ;; \
                --help|-h) echo \"使い方: git wtn <branch> [--start-point <ref>] [--path <path>]\"; exit 0 ;; \
                -*) echo \"不明なオプション: $1\" >&2; exit 2 ;; \
                *) \
                    if [ -z \"$start\" ]; then start=$1; \
                    elif [ -z \"$custom_path\" ]; then custom_path=$1; \
                    else echo \"引数が多すぎます。\" >&2; exit 2; fi; \
                    shift ;; \
            esac; \
        done; \
        if git show-ref --verify --quiet \"refs/heads/$branch\"; then \
            echo \"Error: ブランチ [$branch] は既に存在します。\" >&2; exit 1; \
        fi; \
        if [ -n \"$start\" ] && ! git rev-parse --verify --quiet \"$start^{commit}\" >/dev/null; then \
            echo \"Error: 開始地点 [$start] が見つかりません。\" >&2; exit 1; \
        fi; \
        if [ -n \"$custom_path\" ]; then path=$custom_path; \
        else \
            repo_root=$(git rev-parse --show-toplevel) || exit 1; \
            repo_name=$(basename \"$repo_root\"); \
            safe_name=$(printf \"%s-%s\" \"$repo_name\" \"$branch\" | sed \"s#[^A-Za-z0-9._-]#-#g\"); \
            path=\"$repo_root/../$safe_name\"; \
        fi; \
        if [ -e \"$path\" ]; then echo \"Error: パス [$path] は既に存在します。\" >&2; exit 1; fi; \
        if [ -n \"$start\" ]; then \
            echo \"[$start] から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\" \"$start\"; \
        else \
            echo \"現在の HEAD から新ブランチ [$branch] を作成し、[$path] に展開します...\"; \
            git worktree add -b \"$branch\" \"$path\"; \
        fi' -"

    # worktreeのパスを選択してクリップボードにコピー
    wtp = "!f() { \
        path=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | \
            fzf --prompt='worktree> '); \
        [ -n \"$path\" ] || return 0; \
        if command -v clip.exe >/dev/null 2>&1; then printf '%s' \"$path\" | clip.exe; \
        elif command -v clip >/dev/null 2>&1; then printf '%s' \"$path\" | clip; \
        elif command -v pbcopy >/dev/null 2>&1; then printf '%s' \"$path\" | pbcopy; \
        else echo 'Error: clipboard command not found.' >&2; return 1; fi; \
        printf 'Copied: %s\\n' \"$path\"; \
    }; f"

    # --- 6. add -p ---
    ap = add -p
    ad = !git diff && git add -p
    aps = !git add -p && git status --short
    apc = !git add -p && git commit
    apcm = !git add -p && git commit -m

    # --- 7. Stash ---
    sl = stash list
    sa = stash apply
    sp = stash push -m
    stash-wip = stash push --include-untracked -m "wip"
    unsh = stash pop --index

    # fzfでstashを検索して適用（削除しない）
    stashf = "!f() { \
        entry=$(git stash list --format='%gd %gs' | \
            fzf --prompt='stash> ' --preview 'git stash show --stat --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        git stash apply \"${entry%% *}\"; \
    }; f"

    # fzfでstashを選択して削除
    stashdropf = "!f() { \
        entry=$(git stash list --format='%gd %gs' | \
            fzf --prompt='drop stash> ' --preview 'git stash show --stat --color=always {1}'); \
        [ -n \"$entry\" ] || return 0; \
        stash=${entry%% *}; \
        printf 'Drop %s? [y/N] ' \"$stash\"; read -r answer < /dev/tty; \
        case \"$answer\" in y|Y) git stash drop \"$stash\" ;; *) echo 'Cancelled.' ;; esac; \
    }; f"

    # --- 8. 差分・履歴操作 ---
    d = diff
    dc = diff --cached
    uncommit = reset --soft HEAD^
    dw = diff -w --ignore-all-space
    dwo = diff --word-diff
    reword-at = !sh -c ' \
        if [ -z \"$1\" ]; then echo \"使い方: git reword-at <commit>\" >&2; exit 2; fi; \
        git commit --allow-empty --fixup=reword:\"$1\" && \
        GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash \"$1\"~1' -

    # fzfで未ステージ差分を表示
    dfu = "!f() { \
        file=$(git diff --name-only | fzf --prompt='unstaged diff> ' \
            --preview 'git diff --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; git diff -- \"$file\"; \
    }; f"

    # fzfでステージ済み差分を表示
    dfs = "!f() { \
        file=$(git diff --cached --name-only | fzf --prompt='staged diff> ' \
            --preview 'git diff --cached --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; git diff --cached -- \"$file\"; \
    }; f"

    # fzfで2コミット間の変更ファイルを選択
    rangef = "!f() { \
        base_entry=$(git log --all --color=never --format='%h %s' | \
            fzf --prompt='base commit> ' --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$base_entry\" ] || return 0; base=${base_entry%% *}; \
        target_entry=$(git log --all --color=never --format='%h %s' | \
            fzf --prompt='target commit> ' --preview 'git show --stat --oneline --color=always {1}'); \
        [ -n \"$target_entry\" ] || return 0; target=${target_entry%% *}; \
        file=$(git diff --name-only \"$base\" \"$target\" | \
            fzf --prompt='changed files> ' --preview \"git diff --color=always $base $target -- {}\"); \
        [ -n \"$file\" ] || return 0; git diff \"$base\" \"$target\" -- \"$file\"; \
    }; f"

    # fzfでコンフリクトファイルを選択してマージツールを起動
    conff = "!f() { \
        file=$(git diff --name-only --diff-filter=U | fzf --prompt='conflict> ' \
            --preview 'git diff --cc --color=always -- {}'); \
        [ -n \"$file\" ] || return 0; git mergetool -- \"$file\"; \
    }; f"

    # --- 9. 分析・調査 ---
    today = !"git log --author=\"$(git config user.name)\" --since='midnight' --no-merges --pretty=format:'%C(yellow)%h%Creset %s (%cr)'"
    hh = !"_hh() { \
        count=${1:-1}; \
        case \"$count\" in ''|*[!0-9]*|0) echo 'Error: count は正の整数を指定してください。' >&2; return 2 ;; esac; \
        git log -n \"$count\" --format='%H' | { \
            if command -v clip.exe >/dev/null 2>&1; then clip.exe; \
            elif command -v clip >/dev/null 2>&1; then clip; \
            elif command -v pbcopy >/dev/null 2>&1; then pbcopy; \
            elif command -v xclip >/dev/null 2>&1; then xclip -sel clip; \
            else echo 'Error: clipboard command not found.' >&2; exit 1; fi; \
        } && echo \"Copied recent $count HEAD hash(es) to clipboard.\"; \
    }; _hh"
    lf = !"git ls-files -z | xargs -0 wc -l | sort -rn | head -n 20"
    cf = diff --name-only --diff-filter=U

    # コンフリクトファイルをエディタで開く
    cfe = !"git diff --name-only -z --diff-filter=U | xargs -0 -r code --wait"

    hotfiles = !"git log --name-only --since='1 month ago' --pretty=format: | grep -v '^$' | sort | uniq -c | sort -nr | head -n 20"
    changelog = !"sh -c 'tag=$(git describe --tags --abbrev=0 2>/dev/null) || { echo \"Error: タグがありません。\" >&2; exit 1; }; git log \"$tag..HEAD\" --oneline'"

    ref = reflog --date=relative

    # --- 10. その他 ---
    db = !"sh -c 'ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null) || { echo \"Error: origin/HEAD が未設定です。\" >&2; exit 1; }; git switch \"${ref#refs/remotes/origin/}\"'"

    up = pull --rebase --autostash
    pub = !"git push -u origin HEAD"
    rdb = !"sh -c 'ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null) || { echo \"Error: origin/HEAD が未設定です。\" >&2; exit 1; }; git fetch origin && git rebase \"${ref/refs\\/remotes\\//}\" --autostash'"


[aliasdoc]
    ha = 00|ヘルプ|エイリアスの一覧と用途を表示 / 使い方: git ha

    # --- 切り替え・復元 ---
    sw = 10|切り替え・復元|ブランチを切り替える / 使い方: git sw <ブランチ名>
    swc = 11|切り替え・復元|新規ブランチを作成して切り替える / 使い方: git swc <新ブランチ名>
    back = 12|切り替え・復元|直前にいたブランチに戻る / 使い方: git back
    rs = 13|切り替え・復元|作業ツリーの変更を破棄する / 使い方: git rs <ファイル名>
    unstage = 14|切り替え・復元|ステージングを取り消す / 使い方: git unstage <ファイル名>
    restore-to = 15|切り替え・復元|指定コミットの内容でファイルを復元する / 使い方: git restore-to <commit> <ファイル名>
    swf = 16|切り替え・復元|fzfでブランチを検索して切り替える / 使い方: git swf

    # --- コミット・変更 ---
    st = 20|コミット・変更|状態、コンフリクト、stash、直近コミットを表示 / 使い方: git st
    aa = 21|コミット・変更|全変更をステージングする / 使い方: git aa
    cm = 22|コミット・変更|メッセージ付きでコミットする / 使い方: git cm "<メッセージ>"
    cma = 23|コミット・変更|直近コミットを修正する / 使い方: git cma
    ca = 24|コミット・変更|直近コミットに変更を統合する / 使い方: git ca
    fixup = 25|コミット・変更|指定コミット向けのfixupコミットを作成する / 使い方: git fixup <commit>
    squash = 26|コミット・変更|指定コミット向けのsquashコミットを作成する / 使い方: git squash <commit>
    ap = 27|コミット・変更|差分を選択してステージングする / 使い方: git ap
    ad = 28|コミット・変更|差分を表示してadd -pを開始する / 使い方: git ad
    aps = 29|コミット・変更|add -p後にステータスを表示する / 使い方: git aps
    apc = 30|コミット・変更|add -p後にコミットする / 使い方: git apc
    apcm = 31|コミット・変更|add -p後にメッセージ付きでコミットする / 使い方: git apcm "<メッセージ>"
    sts = 32|コミット・変更|ステータスと差分統計を表示する / 使い方: git sts
    std = 33|コミット・変更|ステータスと単語単位の差分を表示する / 使い方: git std
    addf = 34|コミット・変更|fzfで変更ファイルを選択してステージングする / 使い方: git addf
    unstagef = 35|コミット・変更|fzfでステージ済みファイルを選択して解除する / 使い方: git unstagef
    revertf = 36|コミット・変更|fzfでコミットを選択してrevertする / 使い方: git revertf

    # --- 差分・修正 ---
    d = 40|差分・修正|差分を表示する / 使い方: git d
    dc = 41|差分・修正|ステージ済み差分を表示する / 使い方: git dc
    dw = 42|差分・修正|空白差分を無視する / 使い方: git dw
    dwo = 43|差分・修正|単語単位で差分を表示する / 使い方: git dwo
    uncommit = 44|差分・修正|直近コミットを取り消して変更を保持する / 使い方: git uncommit
    reword-at = 45|差分・修正|過去コミットのメッセージを修正する / 使い方: git reword-at <hash>
    dfu = 46|差分・修正|fzfで未ステージ差分を選択して表示する / 使い方: git dfu
    dfs = 47|差分・修正|fzfでステージ済み差分を選択して表示する / 使い方: git dfs
    rangef = 48|差分・修正|2コミット間の変更ファイルを選択して表示する / 使い方: git rangef
    conff = 49|差分・修正|コンフリクトファイルを選択してマージツールを起動する / 使い方: git conff

    # --- ログ・履歴 ---
    lg = 50|ログ・履歴|履歴を簡易グラフ表示する / 使い方: git lg
    lga = 51|ログ・履歴|全履歴をグラフ表示する / 使い方: git lga
    lgn = 52|ログ・履歴|直近10件の履歴を表示する / 使い方: git lgn
    last = 53|ログ・履歴|直近コミットの要約と統計を表示する / 使い方: git last
    lgs = 54|ログ・履歴|ファイル変更統計付きでログを表示する / 使い方: git lgs
    lgf = 55|ログ・履歴|指定ファイルの履歴と差分を追跡する / 使い方: git lgf <ファイル名>
    lgh = 56|ログ・履歴|差分内容から正規表現で検索する / 使い方: git lgh <検索語>
    showf = 57|ログ・履歴|fzfでコミットを検索して詳細表示する / 使い方: git showf
    findc = 58|ログ・履歴|コミットメッセージを文字列検索する / 使い方: git findc
    reflogf = 59|ログ・履歴|reflogを検索して選択地点を表示する / 使い方: git reflogf
    filelogf = 60|ログ・履歴|ファイルを選択して履歴を表示する / 使い方: git filelogf

    # --- ブランチ整理 ---
    br = 61|ブランチ整理|更新日時の新しい順にブランチを表示する / 使い方: git br
    brs = 62|ブランチ整理|ブランチ詳細一覧を表示する / 使い方: git brs
    brm = 63|ブランチ整理|ブランチ名を変更する / 使い方: git brm <新しいブランチ名>
    bdiff = 64|ブランチ整理|2ブランチ間の差分を表示する / 使い方: git bdiff
    bclean = 65|ブランチ整理|デフォルトブランチにマージ済みのブランチを確認後に削除する / 使い方: git bclean
    bcleanf = 66|ブランチ整理|マージ済みブランチを選択して削除する / 使い方: git bcleanf
    rbf = 67|ブランチ整理|リモートブランチを選択して追跡ブランチを作成・切り替える / 使い方: git rbf
    fa = 68|ブランチ整理|全リモートを取得し削除済み参照を整理する / 使い方: git fa

    # --- worktree ---
    wt = 70|worktree|worktreeサブコマンドを実行する / 使い方: git wt <サブコマンド>
    wtl = 71|worktree|worktree一覧を表示する / 使い方: git wtl
    wta = 72|worktree|既存ブランチをworktreeとして展開する / 使い方: git wta <branch> [<path>]
    wtn = 73|worktree|新規ブランチをworktreeとして展開する / 使い方: git wtn <branch> [--start-point <ref>] [--path <path>]
    wtp = 74|worktree|worktreeのパスを選択してクリップボードにコピーする / 使い方: git wtp

    # --- add -p ---
    ap = 80|部分ステージング|差分を選択してステージングする / 使い方: git ap
    ad = 81|部分ステージング|差分を確認してから部分ステージングする / 使い方: git ad
    aps = 82|部分ステージング|部分ステージング後に状態を表示する / 使い方: git aps
    apc = 83|部分ステージング|部分ステージング後にコミットする / 使い方: git apc
    apcm = 84|部分ステージング|部分ステージング後にメッセージ付きでコミットする / 使い方: git apcm "<メッセージ>"

    # --- stash ---
    sl = 90|stash|stash一覧を表示する / 使い方: git sl
    sa = 91|stash|stashを適用する / 使い方: git sa <stash>
    sp = 92|stash|メッセージ付きでstashに退避する / 使い方: git sp "<メッセージ>"
    stash-wip = 93|stash|未追跡ファイルも含めてWIPとして退避する / 使い方: git stash-wip
    unsh = 94|stash|stashをステージ状態も含めて復元する / 使い方: git unsh
    stashf = 95|stash|fzfでstashを選択して適用する / 使い方: git stashf
    stashdropf = 96|stash|fzfでstashを選択して削除する / 使い方: git stashdropf

    # --- 分析・調査 ---
    today = 100|分析・調査|今日の自分のコミットを表示する / 使い方: git today
    hh = 101|分析・調査|直近コミットのハッシュをクリップボードにコピーする / 使い方: git hh [件数]
    lf = 102|分析・調査|行数の多い追跡ファイルを表示する / 使い方: git lf
    cf = 103|分析・調査|コンフリクトファイル名を表示する / 使い方: git cf
    cfe = 104|分析・調査|コンフリクトファイルをVS Codeで開く / 使い方: git cfe
    hotfiles = 105|分析・調査|直近1か月で変更頻度の高いファイルを表示する / 使い方: git hotfiles
    changelog = 106|分析・調査|最新タグからHEADまでのコミットを表示する / 使い方: git changelog
    ref = 107|分析・調査|reflogを表示する / 使い方: git ref

    # --- その他 ---
    db = 110|その他|リモートのデフォルトブランチに切り替える / 使い方: git db
    up = 111|その他|autostash付きでrebase pullする / 使い方: git up
    pub = 112|その他|現在のブランチをoriginにpushして追跡設定する / 使い方: git pub
    rdb = 113|その他|originのデフォルトブランチを取得してrebaseする / 使い方: git rdb